ck_inittab "FCB-AIX-0003" "rc.nfs"            "rcnfs"
ck_inittab "FCB-AIX-0004" "cas_agent"         "cas_agent"

#=============================================================================
# 5-17　rc.tcpip 常駐服務
#=============================================================================
ck_rctcpip "FCB-AIX-0005" "dhcpcd"      "dhcpcd"
ck_rctcpip "FCB-AIX-0006" "dhcprd"      "dhcprd"
ck_rctcpip "FCB-AIX-0007" "dhcpsd"      "dhcpsd"
ck_rctcpip "FCB-AIX-0008" "gated"       "gated"
ck_rctcpip "FCB-AIX-0009" "mrouted"     "mrouted"
ck_rctcpip "FCB-AIX-0010" "named"       "named"
ck_rctcpip "FCB-AIX-0011" "routed"      "routed"
ck_rctcpip "FCB-AIX-0012" "rwhod"       "rwhod"
ck_rctcpip "FCB-AIX-0013" "sendmail"    "sendmail"
ck_rctcpip "FCB-AIX-0014" "timed"       "timed"
ck_rctcpip "FCB-AIX-0015" "autoconf6"   "autoconf6"
ck_rctcpip "FCB-AIX-0016" "ndpd-host"   "ndpd-host"
ck_rctcpip "FCB-AIX-0017" "ndpd-router" "ndpd-router"

#=============================================================================
# 18-22　NFS
#   先判「這台到底有沒有在用 NFS」——沒在用就是 Not-Applicable，
#   不可以因為「沒設定」就算合規（那是兩件事）
#=============================================================================
NFS_EXPORTS_N=0
[ -f /etc/exports ] && NFS_EXPORTS_N=`grep -vE '^[ 	]*(#|$)' /etc/exports 2>/dev/null | wc -l | tr -d ' '`
if have lsfs; then
    NFS_MOUNTS=`lsfs -v nfs 2>/dev/null | grep -v '^Name' | grep -v '^$'`
    NFS_PROBE_OK=1
else
    NFS_MOUNTS=""
    NFS_PROBE_OK=0
fi

_std18="NFS 掛載選項；沒有 nosuid 就能從 NFS 上跑 setuid 程式提權，( 掛載帶 nosuid 與 nodev )"
if [ "$NFS_PROBE_OK" -eq 0 ]; then
    emit "FCB-AIX-0018" "Error" "$CAT_SVC" "NFS - enable both nosuid and nodev options on NFS client mounts" "$_std18" "此機器無 lsfs 指令（非 AIX？）——未查"
elif [ -z "$NFS_MOUNTS" ]; then
    emit "FCB-AIX-0018" "Not-Applicable" "$CAT_SVC" "NFS - enable both nosuid and nodev options on NFS client mounts" "$_std18" "本機無 NFS 掛載"
else
    # ⚠️ 2026-09-23 自我稽核 B1：原本只 grep -v 'nosuid'，**完全沒有查 nodev**——
    # 而條目標題寫的是 "enable both nosuid and nodev"。
    # 掛載帶了 nosuid、沒有 nodev 的機器會被判合規，報表上看起來查過了，實際只查一半。
    # 這是金融業，稽核問起來解釋不了就是缺失。
    _opts=`grep -p nfs /etc/filesystems 2>/dev/null | grep -i 'options'`
    _bad_su=`echo "$_opts" | grep -v '^$' | grep -v 'nosuid' | head -n 3`
    _bad_nd=`echo "$_opts" | grep -v '^$' | grep -v 'nodev' | head -n 3`
    if [ -z "$_opts" ]; then
        # 有 NFS 掛載（前面判過了）卻讀不到 options，那是沒查到不是沒問題
        emit "FCB-AIX-0018" "Error" "$CAT_SVC" "NFS - enable both nosuid and nodev options on NFS client mounts" "$_std18" "/etc/filesystems 讀不到 nfs 段的 options 行——未查，不可視為合規"
    elif [ -n "$_bad_su" ] || [ -n "$_bad_nd" ]; then
        _miss=""
        [ -n "$_bad_su" ] && _miss="未帶 nosuid: $_bad_su"
        [ -n "$_bad_nd" ] && _miss="$_miss 未帶 nodev: $_bad_nd"
        emit "FCB-AIX-0018" "Non-Compliant" "$CAT_SVC" "NFS - enable both nosuid and nodev options on NFS client mounts" "$_std18" "$_miss"
    else
        emit "FCB-AIX-0018" "Compliant" "$CAT_SVC" "NFS - enable both nosuid and nodev options on NFS client mounts" "$_std18" "所有 NFS 掛載皆帶 nosuid 與 nodev"
    fi
fi

_std19="NFS 輸出對象；輸出給 localhost 等於讓本機任何帳號繞過權限讀到，( 無 localhost 條目 )"
if [ "$NFS_EXPORTS_N" -eq 0 ]; then
    emit "FCB-AIX-0019" "Not-Applicable" "$CAT_SVC" "NFS - localhost removal" "$_std19" "/etc/exports 無有效條目"
else
    _l=`grep -iE 'localhost|127\.0\.0\.1' /etc/exports 2>/dev/null | grep -vE '^[ 	]*#' | head -n 2`
    if [ -n "$_l" ]; then
        emit "FCB-AIX-0019" "Non-Compliant" "$CAT_SVC" "NFS - localhost removal" "$_std19" "$_l"
    else
        emit "FCB-AIX-0019" "Compliant" "$CAT_SVC" "NFS - localhost removal" "$_std19" "/etc/exports 無 localhost 條目（有效條目 $NFS_EXPORTS_N 筆）"
    fi
fi

_std20='NFS 輸出範圍；everyone 代表整個網路都掛得上，( showmount -e 無 everyone )'
if [ "$NFS_EXPORTS_N" -eq 0 ]; then
    emit "FCB-AIX-0020" "Not-Applicable" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "本機未輸出任何 NFS 目錄"
else
    # ⚠️ 2026-09-23 自我稽核 A1：這是全檔**唯一靠外部服務回應**的檢查。
    # 原本只擋「指令不存在」，擋不住「指令執行失敗」——showmount 在 nfsd 沒起來、
    # RPC 不通、防火牆擋 portmapper 時會吐空並回非 0，於是「問不到」被判成 Compliant。
    # 那跟解析端「跑到一半死掉顯示 100% 合規」是同一個形狀，而且更糟：
    # 它同時是整支腳本唯一可能卡死的地方。
    _l=""
    if have showmount; then :; else
        emit "FCB-AIX-0020" "Error" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "此機器無 showmount 指令——未查，不可視為合規"
        _l="__SKIP__"
    fi
    if [ "$_l" != "__SKIP__" ]; then
        run_timeout 15 showmount -e
        if [ "$RT_RC" = "124" ]; then
            emit "FCB-AIX-0020" "Error" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "showmount -e 15 秒內沒有回應（RPC 不通或 nfsd 未啟動）——未查，不可視為合規"
            _l="__SKIP__"
        elif [ "$RT_RC" != "0" ]; then
            emit "FCB-AIX-0020" "Error" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "showmount -e 查詢失敗（離開碼 $RT_RC；nfsd 未啟動或 RPC 被擋）——未查，不可視為合規"
            _l="__SKIP__"
        else
            _l=`echo "$RT_OUT" | grep '(everyone)' | head -n 2`
        fi
    fi
    if [ "$_l" = "__SKIP__" ]; then
        :
    elif [ -n "$_l" ]; then
        emit "FCB-AIX-0020" "Non-Compliant" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "$_l"
    else
        emit "FCB-AIX-0020" "Compliant" "$CAT_SVC" "NFS - restrict NFS access" "$_std20" "showmount -e 無 (everyone)"
    fi
fi

_std21="NFS root 權限；no_root_squash 讓對方的 root 就是這台的 root，( 無 no_root_squash 與 root= )"
if [ "$NFS_EXPORTS_N" -eq 0 ]; then
    emit "FCB-AIX-0021" "Not-Applicable" "$CAT_SVC" "NFS - no_root_squash option" "$_std21" "/etc/exports 無有效條目"
else
    _l=`grep -E 'no_root_squash|root=' /etc/exports 2>/dev/null | grep -vE '^[ 	]*#' | head -n 2`
    if [ -n "$_l" ]; then
        emit "FCB-AIX-0021" "Non-Compliant" "$CAT_SVC" "NFS - no_root_squash option" "$_std21" "$_l"
    else
        emit "FCB-AIX-0021" "Compliant" "$CAT_SVC" "NFS - no_root_squash option" "$_std21" "無 no_root_squash / root= 授權"
    fi
fi

_std22="NFS 認證方式；沒指定 sec= 就是誰都能掛，( 每個輸出都有 sec= )"
if [ "$NFS_EXPORTS_N" -eq 0 ]; then
    emit "FCB-AIX-0022" "Not-Applicable" "$CAT_SVC" "NFS - secure NFS" "$_std22" "/etc/exports 無有效條目"
else
    _l=`grep -vE '^[ 	]*(#|$)' /etc/exports 2>/dev/null | grep -v 'sec=' | head -n 2`
    if [ -n "$_l" ]; then
        emit "FCB-AIX-0022" "Non-Compliant" "$CAT_SVC" "NFS - secure NFS" "$_std22" "未指定 sec=: $_l"
    else
        emit "FCB-AIX-0022" "Compliant" "$CAT_SVC" "NFS - secure NFS" "$_std22" "所有輸出皆指定 sec="
    fi
fi

