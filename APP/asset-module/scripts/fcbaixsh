_std54="OpenSSH 版本；舊版有已知漏洞且缺少現代加密套件，( 8.1 以上 )"
_sv=`ssh -V 2>&1 | head -n 1`
if [ -z "$_sv" ]; then
    emit "FCB-AIX-0054" "Error" "$CAT_SSH" "OpenSSH: Minimum version is 8.1" "$_std54" "ssh -V 無輸出"
else
    _maj=`echo "$_sv" | sed 's/^OpenSSH_//' | cut -f1 -d'.'`
    _min=`echo "$_sv" | sed 's/^OpenSSH_//' | cut -f2 -d'.' | sed 's/[^0-9].*//'`
    echo "$_maj" | grep -Eq '^[0-9]+$' || _maj=0
    echo "$_min" | grep -Eq '^[0-9]+$' || _min=0
    if [ "$_maj" -gt 8 ] || { [ "$_maj" -eq 8 ] && [ "$_min" -ge 1 ]; }; then
        emit "FCB-AIX-0054" "Compliant" "$CAT_SSH" "OpenSSH: Minimum version is 8.1" "$_std54" "$_sv"
    else
        emit "FCB-AIX-0054" "Non-Compliant" "$CAT_SSH" "OpenSSH: Minimum version is 8.1" "$_std54" "$_sv"
    fi
fi

_std55="/etc/shosts.equiv 與 /etc/rhosts.equiv；rhosts 型信任等於免密碼登入，( 兩個檔案皆不存在 )"
_l=""
[ -e /etc/shosts.equiv ] && _l="$_l /etc/shosts.equiv"
[ -e /etc/rhosts.equiv ] && _l="$_l /etc/rhosts.equiv"
if [ -n "$_l" ]; then
    emit "FCB-AIX-0055" "Non-Compliant" "$CAT_SSH" "OpenSSH: Remove /etc/shosts.equiv and /etc/rhosts.equiv" "$_std55" "仍存在:$_l"
else
    emit "FCB-AIX-0055" "Compliant" "$CAT_SSH" "OpenSSH: Remove /etc/shosts.equiv and /etc/rhosts.equiv" "$_std55" "兩個檔案皆不存在"
fi

_std56="各使用者家目錄的 .shosts；個人層級的免密碼信任最難稽核，( 所有家目錄皆無 .shosts )"
if [ "$AM_ROOT" -eq 1 ]; then
    _homes=`awk -F: '$6 ~ /^\// {print $6}' /etc/passwd 2>/dev/null | sort -u`
    _hit=""
    for _h in $_homes; do
        [ -e "$_h/.shosts" ] && _hit="$_hit $_h/.shosts"
    done
    if [ -n "$_hit" ]; then
        emit "FCB-AIX-0056" "Non-Compliant" "$CAT_SSH" "OpenSSH: Remove .shosts files" "$_std56" "仍存在:$_hit"
    else
        emit "FCB-AIX-0056" "Compliant" "$CAT_SSH" "OpenSSH: Remove .shosts files" "$_std56" "已檢查 /etc/passwd 所列家目錄，皆無 .shosts"
    fi
else
    emit "FCB-AIX-0056" "Error" "$CAT_SSH" "OpenSSH: Remove .shosts files" "$_std56" "非 root，無法讀取其他使用者家目錄"
fi

ck_sshd "FCB-AIX-0057" "sshd_config: PermitEmptyPasswords is 'no'" "PermitEmptyPasswords" "^no$"            "SSH PermitEmptyPasswords 參數；允許空密碼等於沒有密碼，( no )"
ck_sshd "FCB-AIX-0058" "sshd_config: LogLevel is 'INFO' or 'VERBOSE'" "LogLevel"          "^(INFO|VERBOSE)$" "SSH LogLevel 參數；記太少就查不出誰連進來過，( INFO 或 VERBOSE )"
ck_sshd "FCB-AIX-0059" "sshd_config: MaxAuthTries is '4'" "MaxAuthTries"                  "^[1-4]$"          "SSH MaxAuthTries 參數；次數放寬等於放任人慢慢猜密碼，( 4 以下 )"

_std60='SSH 條件式例外；例外要集中在 Match 區塊才看得出誰被放寬，( 例外寫在 Match 區塊 )'
if [ -f /etc/ssh/sshd_config ]; then
    _n=`grep -cE '^[ 	]*Match ' /etc/ssh/sshd_config 2>/dev/null | tr -d ' '`
    emit "FCB-AIX-0060" "Compliant" "$CAT_SSH" "sshd_config: Use Conditional exception(s)" "$_std60（人工判讀：例外是否經核准）" "Match 區塊數 = $_n"
else
    emit "FCB-AIX-0060" "Error" "$CAT_SSH" "sshd_config: Use Conditional exception(s)" "$_std60" "讀不到 /etc/ssh/sshd_config"
fi

# 61-63：弱演算法一律判不合規；沒設定就是吃編譯預設，同樣標不合規並附實際值
ck_alg() {      # $1=id $2=名稱 $3=關鍵字 $4=弱演算法 egrep pattern
    _std="SSH $3 演算法；弱演算法可被降級攻擊或離線破解，( 不含 $4 )"
    _out=""
    for _f in /etc/ssh/sshd_config /etc/ssh/ssh_config; do
        [ -f "$_f" ] || continue
        _v=`grep -Ei "^[ 	]*$3[ 	]" "$_f" 2>/dev/null | tail -n 1`
        [ -n "$_v" ] && _out="$_out [$_f] $_v"
    done
    if [ -z "$_out" ]; then
        emit "$1" "Non-Compliant" "$CAT_SSH" "$2" "$_std" "兩個設定檔皆未明示 $3（吃預設值，未明示即視為不合規）"
    elif echo "$_out" | grep -Eiq "$4"; then
        emit "$1" "Non-Compliant" "$CAT_SSH" "$2" "$_std" "含弱演算法:$_out"
    else
        emit "$1" "Compliant" "$CAT_SSH" "$2" "$_std" "$_out"
    fi
}
ck_alg "FCB-AIX-0061" "sshd_config, ssh_config: KexAlgorithms" "KexAlgorithms" "group1-sha1|group-exchange-sha1|gss-"
ck_alg "FCB-AIX-0062" "sshd_config, ssh_config: Ciphers"       "Ciphers"       "arcfour|-cbc|3des|blowfish|cast128"
ck_alg "FCB-AIX-0063" "sshd_config, ssh_config: MACs"          "MACs"          "hmac-md5|hmac-sha1[^-]|hmac-sha1$|96|umac-64[^-]"

#=============================================================================
# 64-67　SNMP / sendmail
#=============================================================================
ck_snmp() {     # $1=id $2=community 名稱
    _f=/etc/snmpdv3.conf
    [ -f "$_f" ] || _f=/etc/snmpd.conf
    _std="SNMP $2 community；預設社群字串等於免密碼讀走網路資訊，( $_f 中無啟用的 $2 )"
    if [ ! -f "$_f" ]; then
        emit "$1" "Not-Applicable" "$CAT_SVC" "SNMP - disable $2 community string" "$_std" "本機無 snmpd 設定檔"
        return
    fi
    if [ "$AM_ROOT" -ne 1 ] && [ ! -r "$_f" ]; then
        emit "$1" "Error" "$CAT_SVC" "SNMP - disable $2 community string" "$_std" "非 root，讀不到 $_f"
        return
    fi
    _l=`grep -iE "^[ 	]*(COMMUNITY|community)[ 	]+$2([ 	]|$)" "$_f" 2>/dev/null | head -n 1`
    if [ -n "$_l" ]; then
        emit "$1" "Non-Compliant" "$CAT_SVC" "SNMP - disable $2 community string" "$_std" "$_f: $_l"
    else
        emit "$1" "Compliant" "$CAT_SVC" "SNMP - disable $2 community string" "$_std" "$_f 無啟用中的 $2 community"
    fi
}
ck_snmp "FCB-AIX-0064" "private"
ck_snmp "FCB-AIX-0065" "system"
ck_snmp "FCB-AIX-0066" "public"

_std67="sendmail 服務狀態；對外郵件服務不該開在一般主機上，( 已停止且不自動啟動 )"
if have lssrc; then _ls=`lssrc -s sendmail 2>/dev/null | grep -v Subsystem | head -n 1`; else _ls="__NOCMD__"; fi
if [ "$_ls" = "__NOCMD__" ]; then
    emit "FCB-AIX-0067" "Error" "$CAT_SVC" "Uninstall/Disable sendmail" "$_std67" "此機器無 lssrc 指令（非 AIX？）——未查"
elif [ -z "$_ls" ]; then
    emit "FCB-AIX-0067" "Compliant" "$CAT_SVC" "Uninstall/Disable sendmail" "$_std67" "SRC 無 sendmail 子系統"
else
    _st=`echo "$_ls" | awk '{print $NF}'`
    if [ "$_st" = "active" ]; then
        emit "FCB-AIX-0067" "Non-Compliant" "$CAT_SVC" "Uninstall/Disable sendmail" "$_std67" "$_ls"
    else
        emit "FCB-AIX-0067" "Compliant" "$CAT_SVC" "Uninstall/Disable sendmail" "$_std67" "$_ls"
    fi
fi

