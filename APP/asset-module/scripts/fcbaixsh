#=============================================================================
# 83-85　PATH 與登入警示語
#=============================================================================
ck_path() {     # $1=id $2=名稱 $3=檔案
    _std="$3 的 PATH；含目前目錄會讓人先跑到同名的假指令，( PATH 不含 . 與 :: )"
    if [ ! -f "$3" ]; then
        emit "$1" "Not-Applicable" "$CAT_SYS" "$2" "$_std" "$3 不存在"
        return
    fi
    if [ ! -r "$3" ]; then
        emit "$1" "Error" "$CAT_SYS" "$2" "$_std" "讀不到 $3（權限不足）"
        return
    fi
    _l=`grep -E '^[ 	]*(export[ 	]+)?PATH=' "$3" 2>/dev/null | grep -E '(^|=|:)\.(:|$)|::' | head -n 2`
    if [ -n "$_l" ]; then
        emit "$1" "Non-Compliant" "$CAT_SYS" "$2" "$_std" "$_l"
    else
        _cur=`grep -E '^[ 	]*(export[ 	]+)?PATH=' "$3" 2>/dev/null | head -n 1`
        [ -z "$_cur" ] && _cur="$3 未設定 PATH"
        emit "$1" "Compliant" "$CAT_SYS" "$2" "$_std" "$_cur"
    fi
}
ck_path "FCB-AIX-0083" "Remove current working directory from default /etc/environment PATH" "/etc/environment"
ck_path "FCB-AIX-0084" "Remove current working directory from root's PATH"                   "/.profile"

_std85="/etc/motd 登入警示語；法遵要求登入前要告知使用者，( 檔案有內容 )"
if [ ! -f /etc/motd ]; then
    emit "FCB-AIX-0085" "Non-Compliant" "$CAT_SYS" "Configuration: /etc/motd" "$_std85" "/etc/motd 不存在"
else
    _n=`grep -vE '^[ 	]*$' /etc/motd 2>/dev/null | wc -l | tr -d ' '`
    if [ "$_n" -gt 0 ]; then
        emit "FCB-AIX-0085" "Compliant" "$CAT_SYS" "Configuration: /etc/motd" "$_std85" "已設定，共 $_n 行；首行: `head -n 1 /etc/motd`"
    else
        emit "FCB-AIX-0085" "Non-Compliant" "$CAT_SYS" "Configuration: /etc/motd" "$_std85" "/etc/motd 內容為空"
    fi
fi

#=============================================================================
# 86-96、98　帳號與密碼原則
#   minalpha / minother：CIS 建議 3，本行依管理辦法保留 1——
#   這是**經核准的例外**，所以標準值欄位要把「建議值」跟「本行值」都寫出來，
#   不可以只寫一個數字讓人以為系統不合規
#=============================================================================
ck_sec "FCB-AIX-0086" "minage"      "/etc/security/user default minage"      "1" "ge" \
       "密碼最短使用期限；可立即改回舊密碼就等於沒換過，( 1 週以上 )"

_std87="帳號密碼雜湊；沒有密碼的帳號等於敞開的門，( 每個未鎖定帳號都有雜湊 )"
if [ "$AM_ROOT" -eq 1 ]; then
    # ⚠️ 2026-09-23 自我稽核 A3：這裡原本還有一行 _nopw=...>/dev/null; echo ""，
    # 輸出被丟掉、變數永遠是空字串、而且沒有任何地方用到它——
    # 它看起來像第二重檢查，其實什麼都沒做，只會誤導讀程式的人。已刪。
    #
    # 另外加一道前置：先確認**檔案真的讀到了**。
    # 沒有這道的話，檔案不存在或 awk 失敗都會讓 _bad 是空的 -> 判成 Compliant，
    # 也就是「沒查到」冒充「沒問題」。
    _pwn=`grep -c ':' /etc/security/passwd 2>/dev/null | tr -d ' '`
    [ -z "$_pwn" ] && _pwn=0
    _bad=`awk -F: '/^[a-zA-Z0-9_]+:$/{u=$1} /password *=/{gsub(/ /,"");split($0,a,"=");if(a[2]==""||a[2]=="*")print u}' /etc/security/passwd 2>/dev/null | tr '\n' ' '`
    if [ "$_pwn" -eq 0 ]; then
        emit "FCB-AIX-0087" "Error" "$CAT_ACC" "All accounts must have a hashed password" "$_std87" "/etc/security/passwd 讀不到任何內容——未查，不可視為合規"
    elif [ -n "$_bad" ]; then
        emit "FCB-AIX-0087" "Non-Compliant" "$CAT_ACC" "All accounts must have a hashed password" "$_std87" "無密碼帳號: $_bad"
    else
        emit "FCB-AIX-0087" "Compliant" "$CAT_ACC" "All accounts must have a hashed password" "$_std87" "/etc/security/passwd 內所有帳號皆有密碼雜湊"
    fi
else
    emit "FCB-AIX-0087" "Error" "$CAT_ACC" "All accounts must have a hashed password" "$_std87" "非 root，讀不到 /etc/security/passwd"
fi

_std88="群組 GID 唯一性；撞號會讓兩個群組共用同一份權限，( GID 無重複 )"
# ⚠️ 2026-09-23 自我稽核 A2：原本沒有任何「檔案讀到了沒」的判斷。
# /etc/group 讀不到 -> _dup 空 -> 判 Compliant，證據字串還會印成
# 「/etc/group 共 　個群組」（數字是空的）。實務風險低（644），但形狀是錯的：
# 「沒有重複」的依據是一個空結果，而沒有任何證據顯示檔案被讀過。
_n=`wc -l < /etc/group 2>/dev/null | tr -d ' '`
[ -z "$_n" ] && _n=0
_dup=`awk -F: '{print $3}' /etc/group 2>/dev/null | sort | uniq -d | tr '\n' ' '`
if [ "$_n" -eq 0 ]; then
    emit "FCB-AIX-0088" "Error" "$CAT_ACC" "All group names and GIDs must be unique" "$_std88" "/etc/group 讀不到任何內容——未查，不可視為合規"
elif [ -n "$_dup" ]; then
    emit "FCB-AIX-0088" "Non-Compliant" "$CAT_ACC" "All group names and GIDs must be unique" "$_std88" "重複 GID: $_dup"
else
    emit "FCB-AIX-0088" "Compliant" "$CAT_ACC" "All group names and GIDs must be unique" "$_std88" "/etc/group 共 $_n 個群組，GID 無重複"
fi

_std89="/etc/security/passwd 的 NOCHECK 旗標；有這個旗標密碼原則就完全不生效，( 無 NOCHECK )"
if [ "$AM_ROOT" -eq 1 ]; then
    _l=`grep -n 'NOCHECK' /etc/security/passwd 2>/dev/null | head -n 3 | tr '\n' ' '`
    if [ -n "$_l" ]; then
        emit "FCB-AIX-0089" "Non-Compliant" "$CAT_ACC" "Ensure new passwords are controlled by password attributes (disable NOCHECK)" "$_std89" "$_l"
        emit "FCB-AIX-0090" "Non-Compliant" "$CAT_ACC" "Ensure password policy is enforced for all users" "$_std89" "$_l"
    else
        emit "FCB-AIX-0089" "Compliant" "$CAT_ACC" "Ensure new passwords are controlled by password attributes (disable NOCHECK)" "$_std89" "/etc/security/passwd 無 NOCHECK"
        emit "FCB-AIX-0090" "Compliant" "$CAT_ACC" "Ensure password policy is enforced for all users" "$_std89" "/etc/security/passwd 無 NOCHECK"
    fi
else
    emit "FCB-AIX-0089" "Error" "$CAT_ACC" "Ensure new passwords are controlled by password attributes (disable NOCHECK)" "$_std89" "非 root，讀不到 /etc/security/passwd"
    emit "FCB-AIX-0090" "Error" "$CAT_ACC" "Ensure password policy is enforced for all users" "$_std89" "非 root，讀不到 /etc/security/passwd"
fi

ck_sec "FCB-AIX-0091" "minlen"      "/etc/security/user default minlen"      "8" "ge" \
       "密碼最小長度；長度是抵抗暴力破解最有效的一項，( 8 個字元以上 )"
ck_sec "FCB-AIX-0092" "minalpha"    "/etc/security/user default minalpha"    "1" "ge" \
       "密碼最少英文字母數；CIS 建議 3，本行依管理辦法保留 1 為經核准之例外，( 1 個以上 )"
ck_sec "FCB-AIX-0093" "minother"    "/etc/security/user default minother"    "1" "ge" \
       "密碼最少非字母字元數；CIS 建議 3，本行依管理辦法保留 1 為經核准之例外，( 1 個以上 )"
ck_sec "FCB-AIX-0094" "maxrepeats"  "/etc/security/user default maxrepeats"  "4" "le" \
       "相同字元可連續使用個數；重複太多會大幅降低強度，( 4 以下，本行設 2 )"
ck_sec "FCB-AIX-0095" "maxage"      "/etc/security/user default maxage"      "13" "le" \
       "密碼最長使用期限；放太久外洩後的暴露期就越長，( 13 週以下，本行設 12 )"
ck_sec "FCB-AIX-0096" "maxexpired"  "/etc/security/user default maxexpired"  "4" "le" \
       "密碼過期後寬限期；拖太久不改等於沒有期限，( 4 週以下 )"

#=============================================================================
# 97　IgnoreRhosts
#=============================================================================
ck_sshd "FCB-AIX-0097" "sshd_config: IgnoreRhosts is 'yes' or 'shosts-only'" "IgnoreRhosts" "^(yes|shosts-only)$" \
        "SSH IgnoreRhosts 參數；rhosts 信任可繞過密碼驗證，( yes 或 shosts-only )"

#=============================================================================
# 98　密碼加密演算法
#=============================================================================
_std98="密碼雜湊演算法；舊演算法可被離線破解，( pwd_algorithm = ssha512 )"
if have lssec; then _o=`lssec -f /etc/security/login.cfg -s usw -a pwd_algorithm 2>/dev/null | tail -n 1`; else _o=""; fi
_v=`echo "$_o" | sed 's/.*=//' | tr -d '" '`
if [ -z "$_o" ]; then
    emit "FCB-AIX-0098" "Error" "$CAT_ACC" "pwd_algorithm" "$_std98" "lssec 無輸出或無此指令（需 root／非 AIX）"
elif [ "$_v" = "ssha512" ]; then
    emit "FCB-AIX-0098" "Compliant" "$CAT_ACC" "pwd_algorithm" "$_std98" "$_o"
else
    emit "FCB-AIX-0098" "Non-Compliant" "$CAT_ACC" "pwd_algorithm" "$_std98" "$_o"
fi

#=============================================================================
# 收尾：這兩行是「這份檔案跑完了」的唯一憑證
#=============================================================================
N_T=`expr $N_C + $N_N + $N_A + $N_E`
echo "Check ended at: `date '+%Y-%m-%d %H:%M:%S'`" >> "$tmp_file"
echo "Check summary: 合計 $N_T 項；Compliant $N_C；Non-Compliant $N_N；Not-Applicable $N_A；Error $N_E" >> "$tmp_file"

mv "$tmp_file" "$flat_txt"
chmod 640 "$flat_txt" "$dbg_file" 2>/dev/null

#=============================================================================
# 轉 HTML（比照 fcbrhelsh 的 F_TXT2HTML，多支援 FCB-AIX- 與四種結果顏色）
#=============================================================================
{
echo "<html><head><meta charset=\"UTF-8\"><title>系統設定檢查</title><style>"
echo "table { border-collapse: collapse; width: 100%; }"
echo "th, td { border: 1px solid black; padding: 8px; text-align: left; }"
echo "th { background-color: #f2f2f2; }"
echo "</style></head><body><h1>系統設定檢查</h1>"
} > "$output_file"

_intable=0
while IFS= read -r line
do
    case "$line" in
        TWGCB-ID*)
            echo "<table><tr><th>ID</th><th>檢查結果</th><th>類別</th><th>原則設定名稱</th><th>標準設定值</th><th>目前值</th></tr>" >> "$output_file"
            _intable=1
            ;;
        FCB-*|TWGCB-*)
            id=`echo "$line" | cut -f1 -d';'`
            result=`echo "$line" | cut -f2 -d';'`
            category=`echo "$line" | cut -f3 -d';'`
            name=`echo "$line" | cut -f4 -d';'`
            standard=`echo "$line" | cut -f5 -d';'`
            currentv=`echo "$line" | cut -f6- -d';'`
            case "$result" in
                Compliant)      color="green"  ;;
                Non-Compliant)  color="red"    ;;
                Error)          color="orange" ;;
                *)              color="gray"   ;;
            esac
            echo "<tr><td>$id</td><td style=\"color: $color;\">$result</td><td>$category</td><td>$name</td><td style='width: 40em;'>$standard</td><td style=\"color: $color;\">$currentv</td></tr>" >> "$output_file"
            ;;
        *)
            [ "$_intable" -eq 1 ] && echo "</table>" >> "$output_file" && _intable=0
            echo "<p>$line</p>" >> "$output_file"
            ;;
    esac
done < "$flat_txt"
[ "$_intable" -eq 1 ] && echo "</table>" >> "$output_file"
echo "</body></html>" >> "$output_file"
chmod 640 "$output_file" 2>/dev/null

echo ""
echo "產出："
echo "  $flat_txt"
echo "  $output_file"
echo "  $dbg_file   <-- 有問題請把這個檔（或畫面）回傳"
echo "合計 $N_T 項；Compliant $N_C；Non-Compliant $N_N；Not-Applicable $N_A；Error $N_E"
