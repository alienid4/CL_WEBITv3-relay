    emit "FCB-AIX-0052" "Compliant" "$CAT_SYS" "Removal of entries from /etc/hosts.equiv" "$_std52" "/etc/hosts.equiv 不存在"
else
    _l=`grep -vE '^[ 	]*(#|$)' /etc/hosts.equiv 2>/dev/null | head -n 3`
    if [ -n "$_l" ]; then
        emit "FCB-AIX-0052" "Non-Compliant" "$CAT_SYS" "Removal of entries from /etc/hosts.equiv" "$_std52" "$_l"
    else
        emit "FCB-AIX-0052" "Compliant" "$CAT_SYS" "Removal of entries from /etc/hosts.equiv" "$_std52" "檔案存在但無有效條目"
    fi
fi

