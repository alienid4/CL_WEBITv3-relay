# 70　稽核子系統目錄所有權
#=============================================================================
_std70="/audit 與 /etc/security/audit 所有權；稽核資料被動過就失去證據力，( root:audit )"
_r70=""
_bad70=0
for _d in /audit /etc/security/audit; do
    if [ ! -e "$_d" ]; then
        _r70="$_r70 [$_d 不存在]"
        continue
    fi
    _l=`ls -ld "$_d" 2>/dev/null`
    _o=`echo "$_l" | awk '{print $3}'`; _g=`echo "$_l" | awk '{print $4}'`
    _r70="$_r70 $_l"
    { [ "$_o" = "root" ] && [ "$_g" = "audit" ]; } || _bad70=1
done
if [ -z "$_r70" ]; then
    emit "FCB-AIX-0070" "Error" "$CAT_LOG" "AUDIT subsystem: /audit and /etc/security/audit" "$_std70" "兩個路徑都讀不到"
elif [ "$_bad70" -eq 1 ]; then
    emit "FCB-AIX-0070" "Non-Compliant" "$CAT_LOG" "AUDIT subsystem: /audit and /etc/security/audit" "$_std70" "$_r70"
else
    emit "FCB-AIX-0070" "Compliant" "$CAT_LOG" "AUDIT subsystem: /audit and /etc/security/audit" "$_std70" "$_r70"
fi

