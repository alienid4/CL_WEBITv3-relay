    { "key": "pw_policy", "category": "政策設定", "label": "密碼原則／帳戶鎖定原則", "os_scope": "both", "check_type": "manual" },
    { "key": "audit_policy", "category": "政策設定", "label": "進階稽核原則設定", "os_scope": "both", "check_type": "manual" },
    { "key": "adv_firewall_policy", "category": "政策設定", "label": "進階安全性的 Windows 防火牆（三個項目停用）", "os_scope": "windows", "check_type": "manual" },
