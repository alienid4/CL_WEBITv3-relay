    { "key": "arcsight_dmz_auth", "category": "日誌", "label": "DMZ 主機本機驗證帳號設定", "os_scope": "both", "check_type": "manual" },
    { "key": "event_log_readers", "category": "日誌", "label": "加入群組 Event Log Readers", "os_scope": "windows", "check_type": "manual" },

