    { "key": "whatsup_device", "category": "監控", "label": "WhatsUp 新增裝置（描述為 IP+用途）", "os_scope": "both", "check_type": "manual" },
    { "key": "whatsup_ping", "category": "監控", "label": "WhatsUp PING(Default) + 動作啟動", "os_scope": "both", "check_type": "manual" },
