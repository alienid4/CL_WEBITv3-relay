{
  "_comment": "伺服器上線前檢查表的項目定義（來源：公司現行 Word 版「伺服器上線前檢查表」，2026-08-15 使用者提供）。做成設定檔不寫死：檢查項目會隨資安政策每年調整，改這裡就好。check_type=auto 的項目由 golive.py 依系統既有事實（host_service 的監聽埠、hardware 的欄位）自動判定，並在上線後每天回檢一次；manual 的項目機器測不到（機櫃位置、群組權限、政策設定），人工勾一次就不再問。os_scope 決定這項對誰出現：both/windows/linux。fact 的三種型別：port_absent=這個埠不該有人聽、port_present=這個埠要聽得到、field_equals=hardware 的某欄位要跟上線當時一致。",
  "items": [
    {
      "key": "os_version",
      "category": "基本設定",
      "label": "作業系統版本與上線時一致",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "field_equals", "field": "os" },
      "note": "版本被就地升級/重灌是重大變更，不該悄悄發生"
    },
    {
      "key": "hostname_fixed",
      "category": "基本設定",
      "label": "電腦名稱與上線時一致",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "field_equals", "field": "hostname" }
    },
    {
      "key": "ip_fixed",
      "category": "基本設定",
      "label": "IP 與上線時一致",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "field_equals", "field": "ip" }
    },
    {
      "key": "telnet_disabled",
      "category": "弱點修補",
      "label": "Telnet 服務停用（不得監聽 23）",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "port_absent", "port": 23 },
      "note": "明文傳輸密碼，資安基本盤；這項失效是典型的『本來刻意關掉、後來被打開』"
    },
    {
      "key": "ftp_disabled",
      "category": "弱點修補",
      "label": "FTP 服務停用（不得監聽 21）",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "port_absent", "port": 21 }
    },
    {
      "key": "snmp_agent",
      "category": "監控",
      "label": "SNMP 代理運作中（監聽 161）",
      "os_scope": "both",
      "check_type": "auto",
      "fact": { "type": "port_present", "port": 161, "proto": "udp" },
      "note": "WhatsUp 監控靠它，agent 被關掉等於這台從監控上消失"
    },
    {
      "key": "ssh_available",
      "category": "基本設定",
      "label": "SSH 可連線（監聽 22）",
      "os_scope": "linux",
      "check_type": "auto",
      "fact": { "type": "port_present", "port": 22 }
    },
    {
      "key": "smb_present",
      "category": "基本設定",
      "label": "SMB 服務運作中（監聽 445）",
      "os_scope": "windows",
      "check_type": "auto",
      "fact": { "type": "port_present", "port": 445 }
    },

    { "key": "raid_tool", "category": "基本設定", "label": "HDD Raid 工具安裝或其他方式", "os_scope": "windows", "check_type": "manual" },
    { "key": "admin_pw", "category": "基本設定", "label": "Administrator／root 密碼設定（永久有效）", "os_scope": "both", "check_type": "manual" },
    { "key": "ap_account", "category": "基本設定", "label": "新增 AP 帳號（永久有效）", "os_scope": "both", "check_type": "manual" },
